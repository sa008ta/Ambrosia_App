<main class="app-shell">
  <section class="daily-special">
  </section>

  <section aria-labelledby="menu-title">
    <div class="section-heading">
      <h2 id="menu-title">メニュー</h2>
      <p><%= @menu_items_count %>品</p>
    </div>

    <% @label_sections.each do |section| %>
      <section class="label-section" aria-labelledby="label-<%= section[:label].id %>">
        <div class="section-heading">
          <h3 id="label-<%= section[:label].id %>"><%= section[:label].name %></h3>
          <p><%= section[:products].size %>品</p>
        </div>

        <div class="label-row" role="list" aria-label="<%= section[:label].name %>の商品一覧">
          <% section[:products].each do |item| %>
            <article class="menu-card label-row-item" role="listitem">
              <%= link_to menu_detail_path(item.id), class: "menu-card-link" do %>
                <% if item.image.attached? %>
                  <%= image_tag(item.image, class: "menu-card-image", alt: item.name, width: 400, height: 300) %>
                <% else %>
                  <%= image_tag("/dammy.jpg", class: "menu-card-image", alt: item.name, width: 400, height: 300) %>
                <% end %>
                <div class="menu-card-body">
                  <h3 class="menu-card-name"><%= item.name %></h3>
                  <p class="menu-card-description"><%= item.description %></p>
                  <div class="menu-card-meta">
                    <span class="menu-card-price">¥<%= item.price %></span>
                    <span class="menu-card-calorie"><%= item.sold_out? ? "売り切れ" : item.label_names_text %></span>
                  </div>
                </div>
              <% end %>
              <% if item.sold_out? %>
                <span class="menu-card-badge">売り切れ</span>
              <% end %>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @label_sections.blank? %>
      <p>表示できる商品がありません。</p>
    <% end %>
  </section>
</main>