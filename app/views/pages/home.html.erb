<div class="home-shell">
  <div class="home-card">
    <h1 class="heading">Ambrosia App</h1>
    <p class="subtitle">食堂オーダー・注文のホーム画面</p>

    <div class="user-summary">
      <strong><%= @user.name %></strong>さん（<%= @user.customer? ? "お客様" : "店員" %>）としてログイン中です。
    </div>
    
    <div class="form-actions">
      <%= button_to "ログアウト", logout_path, method: :delete, class: "secondary-button" %>
    </div>
  </div>
</div>
