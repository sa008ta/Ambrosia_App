<h1>MENU</h1>

<!-- Added: home page menu list using the same dummy image for each item. -->
<% @menu_items.each do |item| %>
  <div>
    <%= link_to menu_detail_path(item[:id]) do %>
      <img src="/dammy.jpg" alt="<%= item[:name] %>" width="220" height="180">
    <% end %>
    <p><strong><%= item[:name] %></strong></p>
    <p>¥<%= item[:price] %></p>
  </div>
<% end %>

<div>
  <%= button_to "ログアウト", logout_path, method: :delete %>
</div>
