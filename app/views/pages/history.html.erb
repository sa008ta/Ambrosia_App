<main class="app-shell history-page">
  <h1>履歴</h1>
<% if @orders.present? %>
  <ul>
    <% @orders.each do |order| %>
      <li>
        <p><strong><%= l(order.created_at, format: :short) %></strong></p>
        <% order.order_items.each do |item| %>
          <p>商品: <%= item.product_name %></p>
          <p>カテゴリ: <%= item.product_category %></p>
          <p>個数: <%= item.quantity %></p>
          <p>単価: ¥<%= item.unit_price %></p>
        <% end %>
        <p>合計: ¥<%= order.total_amount %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>過去の注文履歴はまだありません。</p>
<% end %>
