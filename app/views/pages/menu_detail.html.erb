<main class="app-shell detail-page">
  <%= link_to "← メニューへ戻る", home_path, class: "back-link" %>

  <article class="detail-card">
    <%= image_tag(@menu_item.image_url.presence || "/dammy.jpg", class: "detail-image", alt: @menu_item.name, width: 800, height: 500) %>
    <div class="detail-body">
      <h1 class="detail-title"><%= @menu_item.name %></h1>
      <p class="detail-description"><%= @menu_item.description %></p>
      <p class="detail-price">¥<%= @menu_item.price %></p>

      <dl class="detail-info">
        <div>
          <dt>カテゴリー</dt>
          <dd><%= @menu_item.category %></dd>
        </div>
        <div>
          <dt>商品ID</dt>
          <dd><%= @menu_item.id %></dd>
        </div>
        <div>
          <dt>在庫</dt>
          <dd><%= @menu_item.stock_quantity %></dd>
        </div>
        <div>
          <dt>状態</dt>
          <dd><%= @menu_item.status_label %></dd>
        </div>
      </dl>

      <% if @menu_item.sold_out? %>
        <p>この商品は売り切れです。</p>
      <% else %>
        <%= form_with url: menu_order_path(@menu_item.id), method: :post, class: "order-form" do %>
          <div class="quantity-control" aria-label="注文数量">
            <button type="button" onclick="changeQuantity(-1)" aria-label="数量を減らす">−</button>
            <input id="quantity" type="number" name="quantity" value="1" min="1" max="<%= @menu_item.stock_quantity %>" readonly aria-label="数量">
            <button type="button" onclick="changeQuantity(1)" aria-label="数量を増やす">＋</button>
          </div>
          <%= submit_tag "注文する", class: "primary-button" %>
        <% end %>
      <% end %>
    </div>
  </article>
</main>

<script>
  function changeQuantity(amount) {
    const input = document.getElementById('quantity');
    if (!input) return;
    const nextValue = Number(input.value) + amount;
    const maxValue = Number(input.max) || 99;
    if (nextValue < 1) {
      input.value = 1;
      return;
    }

    input.value = nextValue > maxValue ? maxValue : nextValue;
  }
</script>
