<main class="app-shell">
  <section>
    <h1>商品編集</h1>
    <p><%= link_to "商品を追加", new_product_path %></p>
    <p><%= link_to "店員ホームへ戻る", home_path %></p>
  </section>

  <section>
    <h2>表示ラベル順変更</h2>
    <p><%= link_to "変更", labels_path %></p>
    <% if @labels.present? %>
      <p><%= @labels.map(&:name).join(" / ") %></p>
    <% else %>
      <p>ラベルはまだありません。</p>
    <% end %>
  </section>

  <section>
    <h2>商品一覧</h2>
    <% if @products.present? %>
      <ul>
        <% @products.each do |product| %>
          <li>
            <p>
              <% if product.image.attached? %>
                <%= image_tag(product.image, alt: product.name, width: 120, height: 90) %>
              <% else %>
                <%= image_tag("/dammy.jpg", alt: product.name, width: 120, height: 90) %>
              <% end %>
            </p>
            <p><strong><%= product.name %></strong> (¥<%= product.price %>)</p>
            <p>ラベル: <%= product.label_names_text %></p>
            <p>説明: <%= product.description %></p>
            <p>在庫: <%= product.stock_quantity %></p>
            <p>状態: <%= product.status_label %></p>
            <p>
              <%= link_to "編集", edit_product_path(product) %>
              <%= button_to "削除", product_path(product), method: :delete, form: { style: "display:inline" }, data: { turbo_confirm: "本当に削除しますか？" } %>
            </p>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>商品はまだありません。</p>
    <% end %>
  </section>
</main>
