<main class="app-shell">
  <section>
    <h1>商品編集</h1>

    <%= form_with model: @product, url: product_path(@product), method: :patch do |f| %>
      <div>
        <%= f.label :name, "商品名" %><br>
        <%= f.text_field :name, required: true %>
      </div>
      <div>
        <%= f.label :price, "値段" %><br>
        <%= f.number_field :price, min: 0, required: true %>
      </div>
      <div>
        <%= f.label :stock_quantity, "在庫数" %><br>
        <%= f.number_field :stock_quantity, min: 0, required: true %>
      </div>
      <div>
        <label>ラベル（複数選択可）</label><br>
        <% @labels.each do |label| %>
          <label>
            <%= check_box_tag "product[label_ids][]", label.id, @product.label_ids.include?(label.id) %>
            <%= label.name %>
          </label>
        <% end %>
      </div>
      <div>
        <%= label_tag "product_new_label_names", "新規ラベル（カンマ区切り）" %><br>
        <%= text_field_tag "product[new_label_names]", nil, placeholder: "期間限定, スイーツ" %>
      </div>
      <div>
        <%= f.label :image, "写真ファイル" %><br>
        <%= f.file_field :image, accept: "image/*" %>
      </div>
      <div>
        <%= f.label :description, "説明" %><br>
        <%= f.text_area :description, rows: 4, required: true %>
      </div>
      <div>
        <%= f.submit "更新する" %>
      </div>
    <% end %>

    <p><%= link_to "商品編集へ戻る", products_path %></p>
  </section>
</main>
