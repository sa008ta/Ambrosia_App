<main class="app-shell">
  <section>
    <h1>商品編集</h1>

    <%= form_with model: @product, url: product_path(@product), method: :patch do |f| %>
      <div>
        <%= f.label :name, "商品名" %><br>
        <%= f.text_field :name, required: true %>
      </div>
      <div>
        <%= f.label :price, "値段" %><br>
        <%= f.number_field :price, min: 0, required: true %>
      </div>
      <div>
        <%= f.label :stock_quantity, "在庫数" %><br>
        <%= f.number_field :stock_quantity, min: 0, required: true %>
      </div>
      <div>
        <%= f.label :category, "カテゴリー" %><br>
        <%= f.text_field :category, required: true %>
      </div>
      <div>
        <%= f.label :image, "写真ファイル" %><br>
        <%= f.file_field :image, accept: "image/*", capture: "environment" %>
      </div>
      <div>
        <%= f.label :description, "説明" %><br>
        <%= f.text_area :description, rows: 4, required: true %>
      </div>
      <div>
        <%= f.submit "更新する" %>
      </div>
    <% end %>

    <p><%= link_to "商品編集へ戻る", products_path %></p>
  </section>
</main>
