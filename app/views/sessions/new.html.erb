<div class="auth-shell">
  <div class="auth-card">
    <h1 class="heading">ログイン</h1>
    <p class="subtitle"><%= @role == "staff" ? "店員" : "お客様" %>としてログイン</p>

    <%= form_with url: login_path, method: :post, local: true, html: { class: "auth-form" } do |f| %>
      <input type="hidden" name="role" value="<%= @role %>">

      <div class="field">
        <%= label_tag :username, "ユーザーネーム" %>
        <%= text_field_tag :username, nil, required: true %>
      </div>

      <div class="field">
        <%= label_tag :password, "パスワード" %>
        <%= password_field_tag :password, nil, required: true %>
      </div>

      <div class="form-actions">
        <%= f.submit "ログイン", class: "primary-button" %>
        <%= link_to "戻る", root_path, class: "link-button" %>
      </div>
    <% end %>

    <p class="inline-note">
      <%= link_to "新規登録はこちら", signup_path(@role), class: "link-button" %>
    </p>
  </div>
</div>
