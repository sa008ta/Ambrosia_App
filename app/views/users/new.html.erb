<div class="auth-shell">
  <div class="auth-card">
    <h1 class="heading"><%= @role == "staff" ? "店員" : "お客様" %> 新規登録</h1>
    <p class="subtitle"><%= @role == "staff" ? "店員パスワードを入力して登録してください。" : "個人情報を入力してアカウントを作成してください。" %></p>

    <% if @user.errors.any? %>
      <div class="flash alert">
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: signup_path(@role), method: :post, local: true, html: { class: "auth-form" } do |f| %>
      <div class="field">
        <%= f.label :name, "名前（本名を入力してください）" %>
        <%= f.text_field :name, required: true %>
      </div>

      <div class="field">
        <%= f.label :username, "ユーザーネーム" %>
        <%= f.text_field :username, required: true %>
      </div>

      <div class="field">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, required: true %>
      </div>

      <div class="field">
        <%= f.label :password, "パスワード" %>
        <%= f.password_field :password, required: true %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "パスワード確認" %>
        <%= f.password_field :password_confirmation, required: true %>
      </div>

      <% if @role == "staff" %>
        <div class="field">
          <%= label_tag :staff_password, "店員パスワード" %>
          <%= password_field_tag :staff_password, nil, required: true %>
        </div>
      <% end %>

      <div class="form-actions">
        <%= f.submit "登録する", class: "primary-button" %>
        <%= link_to "戻る", root_path, class: "link-button" %>
        <%= link_to "ログインの方はこちら", login_path(role: @role), class: "link-button" %>
      </div>
    <% end %>
  </div>
</div>
